# Sanity — read (public, safe to bundle)
# ---------------------------------------
# Only needed once the CMS is wired into the public site.
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2024-10-01

# Sanity — write (server-only, DO NOT prefix with VITE_)
# -------------------------------------------------------
# Held by the /api/admin/* serverless functions; never bundled into the client.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2024-10-01
SANITY_WRITE_TOKEN=

# Admin session
# -------------
# ADMIN_PASSWORD_HASH is a bcrypt hash of the admin password.
# Generate with:  node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD', 12))"
#
# SESSION_SECRET signs the JWT held in the httpOnly session cookie.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Launch gate
# -----------
# When to switch from the "launching soon" countdown page to the full site.
# ISO 8601 UTC string. Default (if unset): 2026-10-15T23:00:00Z, which is
# 00:00 WAT on Fri 16 Oct 2026.
VITE_LAUNCH_AT=2026-10-15T23:00:00Z

# Launch mode:
#   auto      — switch at VITE_LAUNCH_AT (default)
#   countdown — always show the launching-soon page (overrides time)
#   live      — always show the full site (overrides time)
#
# Emergency override: edit this in Vercel and redeploy to force either
# state immediately. ~90 seconds end to end.
VITE_LAUNCH_MODE=auto
